# Copy this file to .dev.vars (which git ignores) and fill in your
# Square SANDBOX values from developer.squareup.com. Never commit .dev.vars.
SQUARE_ACCESS_TOKEN=paste-your-sandbox-access-token-here
SQUARE_LOCATION_ID=paste-your-sandbox-location-id-here

# Lets Square send shoppers back to your local preview after paying
SITE_URL=http://localhost:8080

# Optional until you decide: a flat shipping fee in cents (599 = $5.99)
# SHIPPING_FEE_CENTS=599

# Optional: a fixed sales tax rate for items not in your Square catalog
# TAX_PERCENTAGE=8.25

# Local-only webhook settings for simulating Square's payment notifications.
# On Cloudflare, use the signature key Square shows for your subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=local-test-signature-key
SQUARE_WEBHOOK_URL=http://localhost:8787/square/webhook

# Opens the order desk (#admin on the site). Use a long random value, e.g.
# from a password manager. On Cloudflare: npx wrangler secret put ADMIN_KEY
ADMIN_KEY=paste-a-long-random-key-here

# Email. Without a Resend key, EMAIL_DEV_LOG=true prints emails (including
# sign-in codes) to the Worker's log instead. Never set it on Cloudflare.
# RESEND_API_KEY=paste-your-resend-api-key-here
EMAIL_DEV_LOG=true
